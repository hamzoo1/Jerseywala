# Copy this file to ".env.local" (for your computer) and fill in the values.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
#
# Find both Supabase values in: Supabase dashboard -> Project Settings -> API

# Your Supabase "Project URL"  (looks like https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase PUBLISHABLE key (starts with sb_publishable_ ; older projects call
# it the "anon" key). This key is SAFE to be public because Row Level Security
# protects your data. The variable name stays the same either way.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your website address (use http://localhost:3000 while testing, and your
# real address, e.g. https://jerseywala.pk, after deploying)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backup Instagram username, used only until you save one in Admin -> Store Settings
NEXT_PUBLIC_INSTAGRAM_USERNAME=jerseywala.pk

# NOTE: This project NEVER needs the Supabase "service_role" key.
# Do not put it in this file or anywhere in this project.
